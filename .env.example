# ==============================================================================
# HardTrack Solutions — Variáveis de Ambiente (Modelo .env.example)
# Copie para `.env` em execução local e NUNCA versione segredos reais no Git.
# ==============================================================================

# Ambiente: development | test | production
HARDTRACK_ENV=development

# Segredos de assinatura de tokens HMAC-SHA256 e acesso administrativo
# Gere chaves fortes em produção: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
HARDTRACK_SECRET_KEY=troque-por-uma-chave-secreta-forte-em-producao
HARDTRACK_ADMIN_KEY=troque-por-uma-chave-admin-forte-em-producao

# Tempo de vida do token Bearer (em segundos; padrão 86400 = 24h)
TOKEN_TTL_SECONDS=86400

# Origens CORS permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limit por tenant (requisições por minuto -> HTTP 429)
RATE_LIMIT_RPM=1200

# Cotas por plano de Tenant
B2C_MAX_TARGETS=5
B2B_MAX_TARGETS=50

# Diretório dos silos JSON (TinyDB)
STORAGE_DIR=./storage/tenants

# Scraping e resiliência
SCRAPER_TIMEOUT_SECONDS=5.0
SCRAPER_MAX_RETRIES=3
WORKER_POLL_INTERVAL_SECONDS=60
ALLOW_MOCK_URLS=true

# Notificações Telegram (em produção, defina TELEGRAM_MOCK_MODE=false e informe o token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MOCK_MODE=true
AFFILIATE_TAG=hardtrack-20
